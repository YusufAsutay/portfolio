---
/**
 * Tema anahtarı: koyu "Bakır & Grafit" ↔ açık "Datasheet".
 * Görünüşü sürgülü bir anahtar. Ekran okuyucular için role="switch" ve
 * aria-checked kullanıyoruz: "Açık tema, anahtar, kapalı/açık" diye okunur.
 * Seçim tarayıcıda (localStorage) saklanır. Sayfa açılırken kayıtlı temayı
 * uygulayan küçük betik BaseLayout.astro'da, <head> içinde.
 */
import Icon from './Icon.astro';
---

<button class="theme-switch" type="button" role="switch" aria-checked="false" data-theme-toggle>
  <span class="sr-only">Açık tema</span>
  <span class="theme-switch__knob" aria-hidden="true"></span>
  <span class="theme-switch__icon theme-switch__icon--moon" aria-hidden="true"><Icon name="moon" size={13} /></span>
  <span class="theme-switch__icon theme-switch__icon--sun" aria-hidden="true"><Icon name="sun" size={14} /></span>
</button>

<script>
  type Theme = 'dark' | 'light';

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  // Telefon tarayıcısının adres çubuğu rengi, temanın zeminiyle aynı olsun
  const BAR_COLOR: Record<Theme, string> = { dark: '#12110f', light: '#f2efe7' };

  function apply(theme: Theme, remember: boolean) {
    root.dataset.theme = theme;
    toggle?.setAttribute('aria-checked', String(theme === 'light'));
    themeColor?.setAttribute('content', BAR_COLOR[theme]);
    if (remember) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // gizli sekmede depolama kapalı olabilir: seçim hatırlanmaz, sorun değil
      }
    }
  }

  // Anahtarın konumunu, <head>'deki betiğin uyguladığı temaya eşitle
  apply(root.dataset.theme === 'light' ? 'light' : 'dark', false);

  toggle?.addEventListener('click', () => apply(root.dataset.theme === 'light' ? 'dark' : 'light', true));
</script>

<style>
  .theme-switch {
    position: relative;
    flex: none;
    width: 60px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-elev);
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .theme-switch:hover {
    border-color: var(--accent);
  }

  /* Sürgü: koyu temada solda, açık temada sağda */
  .theme-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 2px 8px -2px rgb(var(--glow) / 0.8);
    transition: translate 0.3s var(--ease-out);
  }

  .theme-switch[aria-checked='true'] .theme-switch__knob {
    translate: 28px 0;
  }

  .theme-switch__icon {
    position: absolute;
    top: 3px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--text-faint);
    transition: color 0.3s;
  }

  .theme-switch__icon--moon {
    left: 3px;
  }

  .theme-switch__icon--sun {
    right: 3px;
  }

  /* Sürgünün altında kalan ikon (etkin tema) koyu/açık mürekkep rengini alır */
  .theme-switch[aria-checked='false'] .theme-switch__icon--moon,
  .theme-switch[aria-checked='true'] .theme-switch__icon--sun {
    color: var(--accent-ink);
  }
</style>
